# Copy to .env and adjust. Plain postgresql:// URLs (compose, Supabase) are
# normalized to the psycopg driver by backend/app/settings.py.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orchestrator

# Host port for the compose `db` service. Change it (and the port in DATABASE_URL)
# if something else on your machine already listens on 5432.
POSTGRES_HOST_PORT=5432

# Host port for the dev `backend` service (docker compose --profile dev up backend).
# If you change it, point the Vite dev proxy at it: API_PROXY_TARGET in
# frontend/.env.local (Vite reads env files from frontend/; see frontend/.env.example).
BACKEND_HOST_PORT=8000

# Host port for the full-app `app` service (docker compose up -d --build).
# Change it if something else on your machine already listens on 8000.
APP_HOST_PORT=8000
