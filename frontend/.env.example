# Copy to frontend/.env.local (gitignored) or export in the shell before `npm run dev`.
# Vite reads env files from frontend/, not from the repo root.

# Where the dev server proxies /api. Default: http://localhost:8000.
# Set it when the backend listens elsewhere, e.g. BACKEND_HOST_PORT=8001 -> http://localhost:8001.
API_PROXY_TARGET=http://localhost:8000
